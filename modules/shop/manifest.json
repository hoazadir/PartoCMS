{
    "name": "فروشگاه",
    "slug": "shop",
    "version": "1.0.0",
    "description": "ماژول فروشگاه حرفه‌ای با درگاه‌های پرداخت ایرانی و بین‌المللی",
    "author": "Hooman Oliaei",
    "author_url": "https://github.com/hoazadir",
    "license": "Proprietary",
    "requires": {
        "php": ">=8.0",
        "partocms": ">=1.0.0"
    },
    "permissions": [
        "shop.view",
        "shop.manage",
        "shop.products.view",
        "shop.products.create",
        "shop.products.edit",
        "shop.products.delete",
        "shop.orders.view",
        "shop.orders.edit",
        "shop.payments.manage",
        "shop.coupons.manage"
    ],
    "menu": {
        "title": "فروشگاه",
        "icon": "🛒",
        "url": "/modules/shop/admin/index.php",
        "submenu": [
            {
                "title": "داشبورد",
                "url": "/modules/shop/admin/index.php",
                "icon": "📊"
            },
            {
                "title": "محصولات",
                "url": "/modules/shop/admin/products.php",
                "icon": "📦"
            },
            {
                "title": "دسته‌بندی‌ها",
                "url": "/modules/shop/admin/categories.php",
                "icon": "🏷️"
            },
            {
                "title": "سفارشات",
                "url": "/modules/shop/admin/orders.php",
                "icon": "🧾"
            },
            {
                "title": "مشتریان",
                "url": "/modules/shop/admin/customers.php",
                "icon": "👥"
            },
            {
                "title": "کوپن‌ها",
                "url": "/modules/shop/admin/coupons.php",
                "icon": "🎟️"
            },
            {
                "title": "روش‌های ارسال",
                "url": "/modules/shop/admin/shipping.php",
                "icon": "🚚"
            },
            {
                "title": "گزارش فروش",
                "url": "/modules/shop/admin/reports.php",
                "icon": "📈"
            },
            {
                "title": "تنظیمات",
                "url": "/modules/shop/admin/settings.php",
                "icon": "⚙️"
            }
        ]
    },
    "routes": {
        "/shop": "index.php",
        "/shop/product/:id": "product.php",
        "/shop/category/:slug": "category.php",
        "/shop/cart": "cart.php",
        "/shop/checkout": "checkout.php"
    },
    "database": {
        "tables": [
            "shop_products",
            "shop_categories",
            "shop_product_images",
            "shop_product_variants",
            "shop_product_attributes",
            "shop_carts",
            "shop_cart_items",
            "shop_orders",
            "shop_order_items",
            "shop_order_status_history",
            "shop_customers",
            "shop_coupons",
            "shop_coupon_usage",
            "shop_payment_gateways",
            "shop_transactions",
            "shop_shipping_methods",
            "shop_tax_rates",
            "shop_settings"
        ],
        "migrations": "database/migrations/"
    },
    "settings": {
        "enabled": true,
        "auto_update": false,
        "currency": "IRR",
        "currency_symbol": "تومان"
    },
    "icon": "🛒",
    "menu_group": "commerce",
    "sort_order": 30
}