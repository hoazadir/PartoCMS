    },
    "permissions": [
        "testimonials.view",
        "testimonials.create",
        "testimonials.edit",
        "testimonials.delete",
        "testimonials.approve",
        "testimonials.settings"
    ],
    "menu": {
        "title": "نظرات مشتریان",
        "icon": "💬",
